+            }
+        }
+        # 复制 zip 文件
+        Get-ChildItem -Path $publishDir -Filter "*.zip" | ForEach-Object {
+            $destFile = "$assetsDir\Map\$($_.Name)"
+            if (Test-Path $_.FullName) {
